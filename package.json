{
  "name": "authnook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Passwords & Authentication. Simplified.",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "npx neu run --frontend-lib-dev",
    "build:helper": "powershell -ExecutionPolicy Bypass -File scripts/build-helper.ps1",
    "build": "npm run typecheck && vite build && npx neu build --release",
    "package:win": "node scripts/package-win.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@neutralinojs/lib": "^6.10.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "hash-wasm": "^4.13.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.77.0",
    "otplib": "^13.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.17.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@neutralinojs/neu": "^11.8.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
